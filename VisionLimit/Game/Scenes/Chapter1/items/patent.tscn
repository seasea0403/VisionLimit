[node name="patent" unique_id=223355110 instance=ExtResource("1_5dnbc")]
item_id = "4"
item_name = "神经接入资质证明"
detail_image = ExtResource("2_bhr47")
description = "我至今记得领取神经接入设备的那天，瓢泼的雨，晃动的人群，挤进我风衣里的刺骨的冷。当时的我在想什么？好像是希望下次办证时能有个好天气？几年前那场大单结束后，我的记忆海再也无法写入任何数据，神经接入设备对现在的我而言只是无用的金属。"
can_record = true
record_entry_title = "神经接入设备"
record_entry_description = "托管师的托管工作需要使用神经接入设备建立两人之间的记忆双向通道。托管师进入后，必须在自己的神经网络中运行患者的神经模板，感知患者神经网络的状态。"

