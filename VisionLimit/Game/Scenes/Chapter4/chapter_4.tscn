[node name="newspaper" parent="ZoomViews/ClickableArea_paper/Zoomview_paper/Items" parent_id_path=PackedInt32Array(676050068, 198920514, 1759582505) index="1" unique_id=1469208200]
item_id = "3"
description = "「AbyssEdge Tech」。我好像在某个地方见过这个名字。"
record_entry_title = "临深集团"
record_entry_description = "临深集团为跨境海洋工业联合开发区的主要投资方，主营海洋资源精炼及深加工业务，旗下设有多家运营实体。AbyssEdge Tech为其在中国大陆注册的运营子公司，经营范围涵盖海洋精炼平台建设、技术服务及海洋数据采集。临深集团苍屿精炼有限公司于2039年11月正式竣工投产，「AE-tech」为该集团内部系统沿用的账户标识前缀。"

