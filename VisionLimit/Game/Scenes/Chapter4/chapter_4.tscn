item_id = "6"
description = "这块荣誉是九年前留下的。那时苍屿的渔业还蒸蒸日上，可自 2043 年起便一落千丈，至今都没能回春。"

[node name="bluenote" parent="ZoomViews/ClickableArea_desk/Zoomview_desk/Items" parent_id_path=PackedInt32Array(1229629625, 198920514, 1759582505) index="1" unique_id=1429109202]
item_id = "7"
description = "临深集团？原来 2041 年他们还会配合检测，不知道如今这家在苍屿势力庞大、几乎一手遮天的大公司，还会不会把环保局放在眼里。"

[node name="cup" parent="ZoomViews/ClickableArea_desk/Zoomview_desk/Items" parent_id_path=PackedInt32Array(1229629625, 198920514, 1759582505) index="2" unique_id=1231178518]
item_id = "9"
description = "用来外业勘测收集水样的器具。看着有些年头了。"
can_record = true
record_entry_title = "外业勘测水质采样规程"
record_entry_description = "外业勘测水质采样要求所用器具在下水前彻底清洁并专人管理，以确保数据可溯性、降低交叉污染风险。采样人员通常管理自用器具，器具归属信息与采样负责人直接挂钩。"

