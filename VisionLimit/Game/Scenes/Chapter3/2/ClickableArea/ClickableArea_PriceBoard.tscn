[node name="note" parent="Zoomview_priceboard/Items" parent_id_path=PackedInt32Array(198920514, 1759582505) index="0" unique_id=223355110]
record_entry_title = "C-03海域"
record_entry_description = "C-03为苍屿近岸渔业规划区划分的第三类作业海域，位于苍屿县西北方向约14海里，毗邻县域精炼厂排海管控区外缘。该区域捕捞作业不受配额限制，准入门槛低于A、B类海域，长期由小型独立渔船承包经营。自2039年起，C-03海域渔获在苍屿旧码头市场的流通量持续上升，同期定价呈下行趋势。"

