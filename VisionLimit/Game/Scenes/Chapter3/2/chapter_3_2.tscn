[node name="paint" parent="ZoomViews/ClickableArea_Box/Zoomview_box/Items" parent_id_path=PackedInt32Array(1094917011, 198920514, 1759582505) index="0" unique_id=223355110]
item_name = "渔获筐标签"
description = "入库时间是今天的09:30。来自CY-0887。"
record_entry_title = "渔获溯源系统"
record_entry_description = "苍屿渔业管理局于2020年推行渔获溯源标签制度，要求所有在苍屿旧码头流通的海产品附有统一格式溯源标签，记录来源海域、船只编号、捕捞日期及入库时间，以保障食品安全追溯链完整。标签数据由码头管理系统统一录入，理论上需与对应船只的入港公示记录交叉核验。"
record_entry_title_2 = "出入港公示制度"
record_entry_description_2 = "根据苍屿县港口管理条例，所有在册渔船须在返港前6小时通过海事信息平台提交归港申报，码头管理处据此更新泊位状态公示。公示信息具有一定法律效力，可作为渔船作业时段的参考依据。泊位公示与溯源标签之间的时间差异，理论上不应超过归港申报的合理误差范围。"

