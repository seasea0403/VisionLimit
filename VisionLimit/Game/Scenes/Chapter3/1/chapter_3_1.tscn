[node name="Zoomview" parent="ZoomViews/ClickableArea_Information2/Zoomview_information2/ClickableArea_Book" parent_id_path=PackedInt32Array(676050068, 1437686243) index="1" unique_id=198920514]
visible = false
show_detail_on_open = true
detail_title = "苍屿症"
detail_description = "苍屿症从前几年出现至今，一直没有很好的对策。近几年医院神经护理区除了重度记忆紊乱患者外，就是苍屿症患者了。该病的起因至今仍不明朗，大家都觉得这是与渔业环境有关的地域性疑难杂病......"

[node name="smallnote" parent="ZoomViews/ClickableArea_Information2/Zoomview_information2/ClickableArea_Book/Zoomview/Items" parent_id_path=PackedInt32Array(676050068, 1437686243, 198920514, 1759582505) index="0" unique_id=223355110]
description = "就诊计划频繁调整，究竟是就诊资源紧张，还是存在其他因素?"
can_record = true
record_entry_title = "苍屿症"
record_entry_description = "苍屿症为非官方命名，指苍屿县群体中持续出现的以神经发育迟滞、感知觉异常及海芯写入障碍为主要表征的一类病例集合。由于现有病例未被统一归档至同一诊断类别，各级卫生主管部门迄今未就此开具正式病名或启动系统性流行病学调查。症状首次集中出现于2043年，发病分布与苍屿旧码头附近渔业作业人员家属高度重叠。"

