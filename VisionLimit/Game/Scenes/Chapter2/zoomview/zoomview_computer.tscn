[node name="Zoomview_Computer" unique_id=198920514 instance=ExtResource("1_mwil0")]
show_detail_on_open = true
detail_title = "魏江的电脑"
detail_description = "十一次。三个月。——我在她的记忆海里待了整整三个月。
四年前我刚被前一家公司清退。晴野基金会找上门的时候很客气，价钱也客气得过分。我几乎没有拒绝的理由。于是我接受了这单奇怪的记忆紊乱治疗委托。
治疗完成后我接受了空前严苛的记忆清洗，我以为一切都结束了。"

